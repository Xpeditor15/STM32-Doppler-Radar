`timescale 1ns / 1ps

module SR8CE_MXILINX_shift_register_1(C, 
                                      CE, 
                                      CLR, 
                                      SLI, 
                                      Q);

    input C;
    input CE;
    input CLR;
    input SLI;
   output [7:0] Q;
   
   wire [7:0] Q_DUMMY;
   
   assign Q[7:0] = Q_DUMMY[7:0];
   FDCE #( .INIT(1'b0) ) Q0 (.C(C), 
