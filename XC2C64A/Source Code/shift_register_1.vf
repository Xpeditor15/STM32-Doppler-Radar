            .CLR(CLR), 
            .D(SLI), 
            .Q(Q_DUMMY[0]));
   FDCE #( .INIT(1'b0) ) Q1 (.C(C), 
            .CE(CE), 
            .CLR(CLR), 
            .D(Q_DUMMY[0]), 
            .Q(Q_DUMMY[1]));
   FDCE #( .INIT(1'b0) ) Q2 (.C(C), 
            .CE(CE), 
            .CLR(CLR), 
            .D(Q_DUMMY[1]), 
            .Q(Q_DUMMY[2]));
   FDCE #( .INIT(1'b0) ) Q3 (.C(C), 
            .CE(CE), 
            .CLR(CLR), 
            .D(Q_DUMMY[2]), 
            .Q(Q_DUMMY[3]));
   FDCE #( .INIT(1'b0) ) Q4 (.C(C), 
            .CE(CE), 
            .CLR(CLR), 
            .D(Q_DUMMY[3]), 
            .Q(Q_DUMMY[4]));
   FDCE #( .INIT(1'b0) ) Q5 (.C(C), 
            .CE(CE), 
            .CLR(CLR), 
            .D(Q_DUMMY[4]), 
            .Q(Q_DUMMY[5]));
   FDCE #( .INIT(1'b0) ) Q6 (.C(C), 
            .CE(CE), 
            .CLR(CLR), 
            .D(Q_DUMMY[5]), 
            .Q(Q_DUMMY[6]));
   FDCE #( .INIT(1'b0) ) Q7 (.C(C), 
            .CE(CE), 
            .CLR(CLR), 
            .D(Q_DUMMY[6]), 
            .Q(Q_DUMMY[7]));
endmodule
`timescale 1ns / 1ps

module shift_register_1(CE, 
                        Clear, 
                        Clock, 
                        Serial_Data_In, 
                        Q);

    input CE;
    input Clear;
    input Clock;
    input Serial_Data_In;
   output [7:0] Q;
   
   
   (* HU_SET = "XLXI_1_0" *) 
   SR8CE_MXILINX_shift_register_1  XLXI_1 (.C(Clock), 
