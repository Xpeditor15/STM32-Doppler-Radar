`timescale 1ns / 1ps

module shift_register(CE, 
                      Clear, 
                      Clock, 
                      D, 
                      Q);

    input CE;
    input Clear;
    input Clock;
    input [7:0] D;
   output [7:0] Q;
   
   
   (* HU_SET = "XLXI_17_0" *) 
   FD8CE_MXILINX_shift_register  XLXI_17 (.C(Clock), 
