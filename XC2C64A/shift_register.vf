module FD8CE_MXILINX_shift_register(C, 
                                    CE, 
                                    CLR, 
                                    D, 
                                    Q);

    input C;
    input CE;
    input CLR;
    input [7:0] D;
   output [7:0] Q;
   
   
   FDCE #( .INIT(1'b0) ) Q0 (.C(C), 
